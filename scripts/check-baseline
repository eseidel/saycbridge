#!/usr/bin/env python
# Copyright (c) 2013 The SAYCBridge Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

"""Run the SAYC expectation harness and compare it with the accepted baseline.

    scripts/check-baseline            # exit 0 iff nothing changed except fixed misses
    scripts/check-baseline --accept   # make the current output the new baseline

Two files under src/ are the baseline: z3b_baseline.txt is the harness output itself
(one FAIL line per known miss, group pass counts, coverage lists, WARNING lines for ties),
z3b_rules_baseline.txt is one line per test: the call made, the rule that made it, and
the rules used to interpret the last three calls.  Any difference is a behaviour change
of the bidder.  The only difference this script accepts is a FAIL line that went away
(a known miss got fixed), that hand's own rules line, and the pass counts that move with
it.  --accept refuses an uncommitted tree and prints the diff it is accepting, so the
reviewed artifact is always the baseline diff in the commit.
"""

import difflib
import os
import re
import subprocess
import sys

SRC = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src')
BASELINE = os.path.join(SRC, 'z3b_baseline.txt')
RULES_BASELINE = os.path.join(SRC, 'z3b_rules_baseline.txt')
ACTUAL = os.path.join(SRC, 'z3b_actual.txt')
ACTUAL_ERR = os.path.join(SRC, 'z3b_actual.err')
RULES_ACTUAL = os.path.join(SRC, 'z3b_rules_actual.txt')
TIMEOUT_SECONDS = 900  # a normal run takes about 30 s
PASS_LINE = re.compile(r'^Pass (\d+)( \([0-9.]+%\))? of (\d+) (total )?hands$')


def normalize(text):
    lines = []
    for line in text.splitlines():
        line = line.rstrip()
        if line.startswith('FAIL:'):
            line = line.rstrip('.')
        lines.append(line)
    return lines


def run_harness():
    env = dict(os.environ, PYTHONHASHSEED='0')
    with open(ACTUAL, 'w') as out, open(ACTUAL_ERR, 'w') as err:
        try:
            subprocess.call([sys.executable, os.path.join(SRC, '..', 'scripts', 'test-sayc'),
                             'TestHarness', '--dump', RULES_ACTUAL],
                            cwd=SRC, stdout=out, stderr=err, env=env, timeout=TIMEOUT_SECONDS)
        except subprocess.TimeoutExpired:
            print('HARNESS TIMED OUT after %ds (a hung worker? see %s)' % (TIMEOUT_SECONDS, ACTUAL_ERR))
            sys.exit(2)
    text = open(ACTUAL).read()
    errors = [line for line in text.splitlines() if line.startswith('ERROR:')]
    if errors or not re.search(r'^Pass \d+ .* total hands$', text, re.M):
        print(text[-3000:])
        print(open(ACTUAL_ERR).read()[-1500:])
        print('HARNESS DID NOT COMPLETE CLEANLY (%d hands raised)' % len(errors))
        sys.exit(2)
    return text


def read(path):
    if not os.path.exists(path):
        print('missing %s (run with --accept to create it)' % path)
        sys.exit(2)
    return open(path).read()


FAIL_LINE = re.compile(r'^FAIL: (\S+) \(expected (\S+)\) for (\S+) .*history: ([^(]*?)\s*(\(subtest.*)?$')


def compare_output(baseline, actual):
    fixed, problems = [], []
    for line in difflib.unified_diff(baseline, actual, n=0, lineterm=''):
        if line.startswith(('---', '+++', '@@')):
            continue
        if line.startswith('-') and line[1:].startswith('FAIL:'):
            fixed.append(line[1:])
        elif PASS_LINE.match(line[1:]):
            continue  # pass counts move with fixed misses; the hand counts are checked below
        else:
            problems.append(line)
    old_counts = [PASS_LINE.match(l).group(3) for l in baseline if PASS_LINE.match(l)]
    new_counts = [PASS_LINE.match(l).group(3) for l in actual if PASS_LINE.match(l)]
    if old_counts != new_counts:
        problems.append('hand counts changed: %s -> %s' % (old_counts, new_counts))
    return fixed, problems


def main():
    if '--accept' in sys.argv:
        dirty = subprocess.run(['git', 'status', '--porcelain', '--', 'src', 'scripts'], cwd=SRC,
                               capture_output=True, text=True).stdout
        if dirty.strip():
            print('refusing to accept with uncommitted changes:\n' + dirty)
            return 2
        run_harness()
        for actual, baseline in ((ACTUAL, BASELINE), (RULES_ACTUAL, RULES_BASELINE)):
            if os.path.exists(baseline):
                for line in difflib.unified_diff(normalize(open(baseline).read()), normalize(open(actual).read()),
                                                 fromfile=baseline, tofile=actual, n=0, lineterm=''):
                    print(line)
            os.replace(actual, baseline)
        print('accepted: %s, %s' % (BASELINE, RULES_BASELINE))
        return 0
    actual = normalize(run_harness())
    baseline = normalize(read(BASELINE))
    fixed, problems = compare_output(baseline, actual)
    rules_diff = [l for l in difflib.unified_diff(read(RULES_BASELINE).splitlines(),
                                                  open(RULES_ACTUAL).read().splitlines(),
                                                  n=0, lineterm='')
                  if not l.startswith(('---', '+++', '@@'))]
    # A fixed miss changes its own rules line (the call is now the expected one): accept
    # exactly that line pair, nothing else.
    expected_by_hand = {}
    for line in fixed:
        m = FAIL_LINE.match(line)
        if m:
            expected_by_hand[(m.group(3), m.group(4).strip())] = m.group(2)
    def is_fixed_line(l):
        identifier, call = l[1:].split('\t')[:2]
        hand, history = identifier.split('-', 1)[0], identifier.split(':')[-1].replace(',', ' ')
        want = expected_by_hand.get((hand, history))
        return want is not None and (l.startswith('-') or call == want)
    rules_diff = [l for l in rules_diff if not is_fixed_line(l)]
    for line in fixed:
        print('fixed: ' + line)
    for line in problems:
        print('CHANGED: ' + line)
    for line in rules_diff:
        print('RULES CHANGED: ' + line)
    total = [l for l in actual if PASS_LINE.match(l) and 'total' in l]
    print(total[-1] if total else 'no total line')
    if problems or rules_diff:
        print('BASELINE MISMATCH: %d output lines, %d rule lines' % (len(problems), len(rules_diff)))
        return 1
    print('baseline ok (%d fixed misses)' % len(fixed))
    return 0


if __name__ == '__main__':
    sys.exit(main())
